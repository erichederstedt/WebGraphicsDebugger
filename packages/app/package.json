  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "playwright": "1.45.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
